# Copiar a .env.local para desarrollo. Sin VITE_POWER_AUTOMATE_URL la app corre en MODO DEMO
# (completa, valida y genera el PDF, pero no hace el POST).
#
# ATENCIÓN: todo lo que empieza con VITE_ se inlinea en el bundle y es PÚBLICO.
# Nunca pongas acá un secreto real (password de SP, client secret de Graph, token de Outlook).
VITE_POWER_AUTOMATE_URL=
VITE_TACKER_KEY=
